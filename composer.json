{
    "name": "lhaamed/media-module",
    "description": "filesystem for laravel",
    "type": "library",
    "require": {
        "php": "^8.1",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "intervention/image": "^3.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "lhaamed\\MediaModule\\": "src"
        }
    },
    "authors": [
        {
            "name": "lhaamed",
            "email": "lhaamed.business@gmail.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "lhaamed\\MediaModule\\MediaServiceProvider"
            ],
            "aliases": {
                "MediaFacade": "lhaamed\\MediaModule\\MediaFacade"
            }
        }
    }
}
